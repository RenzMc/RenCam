<?xml version="1.0" encoding="utf-8"?>
<!-- RenCam in-app gallery: a single square media cell with Live Photo / video badges. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/gallery_item_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#22000000"
        android:contentDescription="@string/gallery_title" />

    <!-- "LIVE" badge, only shown for Live Photos -->
    <TextView
        android:id="@+id/gallery_item_live_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:background="@drawable/bg_live_photo_badge"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="@string/live_photo_badge"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Play overlay for Live Photos and videos -->
    <ImageView
        android:id="@+id/gallery_item_play"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_gallery_play"
        android:padding="7dp"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="@string/live_photo_play"
        android:visibility="gone" />

    <!-- Small video indicator, only shown for videos -->
    <ImageView
        android:id="@+id/gallery_item_video_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:src="@drawable/shortcut_ic_videocam_white_48dp"
        android:contentDescription="@string/gallery_video"
        android:visibility="gone" />

</FrameLayout>
